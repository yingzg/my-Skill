<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.OrderMapper">

  <!-- ================================================================ -->
  <!-- 区块 1: 静态 SELECT                                                   -->
  <!-- ================================================================ -->

  <select id="findById" resultType="com.example.entity.Order">
    SELECT id, order_no, status, created_at
    FROM orders
    WHERE id = #{id}
  </select>

  <select id="findByOrderNo" resultType="com.example.entity.Order">
    SELECT id, order_no, amount
    FROM orders
    WHERE order_no = #{orderNo}
  </select>

  <select id="findAll" resultType="com.example.entity.Order">
    SELECT * FROM orders
  </select>

  <select id="countByStatus" resultType="int">
    SELECT COUNT(*) FROM orders WHERE status = #{status}
  </select>

  <!-- ================================================================ -->
  <!-- 区块 2: 静态 DML                                                      -->
  <!-- ================================================================ -->

  <update id="updateStatus">
    UPDATE orders SET status = #{status}, updated_at = NOW()
    WHERE id = #{id}
  </update>

  <update id="updateStatusNoWhere">
    UPDATE orders SET status = #{status}
  </update>

  <delete id="deleteById">
    DELETE FROM orders WHERE id = #{id}
  </delete>

  <delete id="deleteAll">
    DELETE FROM orders
  </delete>

  <insert id="insertOrder">
    INSERT INTO orders (order_no, status, amount, created_at)
    VALUES (#{orderNo}, #{status}, #{amount}, NOW())
  </insert>

  <!-- ================================================================ -->
  <!-- 区块 3: 静态 JOIN                                                    -->
  <!-- ================================================================ -->

  <select id="findWithDetail" resultType="com.example.entity.Order">
    SELECT o.id, o.order_no, d.product_name, d.quantity
    FROM orders o
    JOIN order_detail d ON o.id = d.order_id
    WHERE o.id = #{id}
  </select>

  <select id="findWithMultipleJoins" resultType="com.example.entity.Order">
    SELECT o.id, o.order_no, d.product_name, u.name AS user_name
    FROM orders o
    LEFT JOIN order_detail d ON o.id = d.order_id
    LEFT JOIN users u ON o.user_id = u.id
    WHERE o.status = #{status}
  </select>

  <!-- ================================================================ -->
  <!-- 区块 4: 静态子查询                                                    -->
  <!-- ================================================================ -->

  <select id="findBySubQuery" resultType="com.example.entity.Order">
    SELECT id, order_no, status
    FROM orders
    WHERE user_id IN (
      SELECT id FROM users WHERE status = 'ACTIVE'
    )
  </select>

  <!-- ================================================================ -->
  <!-- 区块 5: 动态标签 — &lt;if&gt;                                           -->
  <!-- ================================================================ -->

  <select id="findByCondition" resultType="com.example.entity.Order">
    SELECT id, order_no, status
    FROM orders
    WHERE 1=1
    <if test="status != null">AND status = #{status}</if>
    <if test="orderNo != null and orderNo != ''">AND order_no = #{orderNo}</if>
  </select>

  <select id="findBySingleIf" resultType="com.example.entity.Order">
    SELECT id, order_no, status FROM orders
    <if test="amount != null">WHERE amount > #{amount}</if>
  </select>

  <update id="updateByIf">
    UPDATE orders SET updated_at = NOW()
    <if test="status != null">, status = #{status}</if>
    <if test="amount != null">, amount = #{amount}</if>
    WHERE id = #{id}
  </update>

  <!-- ================================================================ -->
  <!-- 区块 6: 动态标签 — &lt;choose&gt;/&lt;when&gt;/&lt;otherwise&gt;                  -->
  <!-- ================================================================ -->

  <select id="findByChoose" resultType="com.example.entity.Order">
    SELECT id, order_no, status FROM orders
    <where>
      <choose>
        <when test="status != null">AND status = #{status}</when>
        <when test="orderNo != null">AND order_no = #{orderNo}</when>
        <otherwise>AND id > 0</otherwise>
      </choose>
    </where>
  </select>

  <!-- ================================================================ -->
  <!-- 区块 7: 动态标签 — &lt;foreach&gt;                                       -->
  <!-- ================================================================ -->

  <select id="findByIds" resultType="com.example.entity.Order">
    SELECT id, order_no, status
    FROM orders
    WHERE id IN
    <foreach collection="ids" item="id" open="(" close=")" separator=",">
      #{id}
    </foreach>
  </select>

  <insert id="batchInsert">
    INSERT INTO orders (order_no, status, amount)
    VALUES
    <foreach collection="list" item="order" separator=",">
      (#{order.orderNo}, #{order.status}, #{order.amount})
    </foreach>
  </insert>

  <delete id="deleteByIds">
    DELETE FROM orders WHERE id IN
    <foreach collection="ids" item="id" open="(" close=")" separator=",">
      #{id}
    </foreach>
  </delete>

  <!-- ================================================================ -->
  <!-- 区块 8: 动态标签 — &lt;where&gt;                                        -->
  <!-- ================================================================ -->

  <select id="findByWhere" resultType="com.example.entity.Order">
    SELECT id, order_no, status FROM orders
    <where>
      <if test="status != null">AND status = #{status}</if>
      <if test="orderNo != null">AND order_no = #{orderNo}</if>
      <if test="amount != null">AND amount >= #{amount}</if>
    </where>
  </select>

  <!-- ================================================================ -->
  <!-- 区块 9: 动态标签 — &lt;set&gt;                                          -->
  <!-- ================================================================ -->

  <update id="updateBySet">
    UPDATE orders
    <set>
      <if test="status != null">status = #{status},</if>
      <if test="amount != null">amount = #{amount},</if>
      updated_at = NOW(),
    </set>
    WHERE id = #{id}
  </update>

  <!-- ================================================================ -->
  <!-- 区块 10: 动态标签 — &lt;trim&gt;                                        -->
  <!-- ================================================================ -->

  <select id="findByTrim" resultType="com.example.entity.Order">
    SELECT id, order_no, status FROM orders
    <trim prefix="WHERE" prefixOverrides="AND |OR ">
      <if test="status != null">AND status = #{status}</if>
      <if test="orderNo != null">AND order_no = #{orderNo}</if>
    </trim>
  </select>

  <update id="updateByTrimSet">
    UPDATE orders
    <trim prefix="SET" suffixOverrides=",">
      <if test="status != null">status = #{status},</if>
      <if test="amount != null">amount = #{amount},</if>
    </trim>
    WHERE id = #{id}
  </update>

  <!-- ================================================================ -->
  <!-- 区块 11: 动态标签 — &lt;bind&gt;                                        -->
  <!-- ================================================================ -->

  <select id="findByBind" resultType="com.example.entity.Order">
    <bind name="pattern" value="'%' + keyword + '%'"/>
    SELECT id, order_no, status FROM orders
    WHERE order_no LIKE #{pattern}
  </select>

  <select id="findByBindWithIf" resultType="com.example.entity.Order">
    <bind name="pattern" value="'%' + keyword + '%'"/>
    SELECT id, order_no, status FROM orders
    <where>
      <if test="keyword != null and keyword != ''">
        order_no LIKE #{pattern}
      </if>
    </where>
  </select>

  <!-- ================================================================ -->
  <!-- 区块 12: 动态标签 — &lt;include&gt; + &lt;sql&gt;                           -->
  <!-- ================================================================ -->

  <sql id="BaseColumnList">
    id, order_no, status, amount, user_id, created_at, updated_at
  </sql>

  <sql id="WhereClause">
    <where>
      <if test="status != null">AND status = #{status}</if>
      <if test="user_id != null">AND user_id = #{user_id}</if>
    </where>
  </sql>

  <select id="findWithInclude" resultType="com.example.entity.Order">
    SELECT <include refid="BaseColumnList"/> FROM orders
    <include refid="WhereClause"/>
  </select>

  <!-- ================================================================ -->
  <!-- 区块 13: 混合标签（if + foreach + where 同时出现）                       -->
  <!-- ================================================================ -->

  <select id="findByMixed" resultType="com.example.entity.Order">
    SELECT id, order_no, status, amount FROM orders
    <where>
      <if test="statusList != null and statusList.size() > 0">
        AND status IN
        <foreach collection="statusList" item="s" open="(" close=")" separator=",">
          #{s}
        </foreach>
      </if>
      <if test="minAmount != null">AND amount >= #{minAmount}</if>
      <if test="maxAmount != null">AND amount &lt;= #{maxAmount}</if>
    </where>
    <if test="orderBy != null">ORDER BY ${orderBy}</if>
  </select>

  <!-- ================================================================ -->
  <!-- 区块 14: 多 namespace（测试 datasource 映射）                          -->
  <!-- ================================================================ -->

</mapper>

<!-- 第二个 namespace，用于测试跨 namespace datasource 解析 -->
<mapper namespace="com.example.mapper.UserMapper">

  <select id="findUserById" resultType="com.example.entity.User">
    SELECT id, name, email FROM users WHERE id = #{id}
  </select>

  <select id="findUserWithOrders" resultType="com.example.entity.User">
    SELECT u.id, u.name, COUNT(o.id) AS order_count
    FROM users u
    LEFT JOIN orders o ON u.id = o.user_id
    WHERE u.status = #{status}
    GROUP BY u.id, u.name
    ORDER BY order_count DESC
    LIMIT #{limit}
  </select>

  <select id="findUsersByKeyword" resultType="com.example.entity.User">
    <bind name="pattern" value="'%' + keyword + '%'"/>
    SELECT id, name, email FROM users
    <where>
      <choose>
        <when test="keyword != null">name LIKE #{pattern}</when>
        <otherwise>1=1</otherwise>
      </choose>
    </where>
  </select>

</mapper>

<!-- ================================================================ -->
<!-- 回归区 — 线上异常 case，按 GH-XXX 命名                                -->
<!-- ================================================================ -->

<mapper namespace="com.example.mapper.RegressionMapper">

  <!-- GH-001: foreach collection 为空时不崩溃 -->
  <select id="gh001_emptyForeach" resultType="com.example.entity.Order">
    SELECT id, status FROM orders WHERE id IN
    <foreach collection="emptyList" item="id" open="(" close=")" separator=",">
      #{id}
    </foreach>
  </select>

  <!-- GH-002: foreach 内嵌 if -->
  <update id="gh002_foreachNestedIf">
    <foreach collection="list" item="order" separator=";">
      UPDATE orders
      <set>
        <if test="order.status != null">status = #{order.status}</if>
        <if test="order.amount != null">amount = #{order.amount}</if>
      </set>
      WHERE id = #{order.id}
    </foreach>
  </update>

  <!-- GH-003: Like 左模糊导致索引失效 -->
  <select id="gh003_leftLike" resultType="com.example.entity.Order">
    SELECT id, order_no FROM orders
    WHERE order_no LIKE CONCAT('%', #{keyword})
  </select>

  <!-- GH-004: LIMIT 前无 ORDER BY 导致分页不稳定 -->
  <select id="gh004_limitNoOrder" resultType="com.example.entity.Order">
    SELECT id, order_no FROM orders
    WHERE status = #{status}
    LIMIT #{offset}, #{limit}
  </select>

</mapper>
