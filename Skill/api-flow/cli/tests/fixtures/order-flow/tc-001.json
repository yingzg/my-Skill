{
  "id": "tc-001",
  "scenario": "正常创建订单",
  "branch": "产品存在、库存充足",
  "priority": "high",
  "expect_error": false,
  "request": {
    "method": "POST",
    "url": "/api/orders",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "productId": "{{@product_id}}",
      "userId": "{{@user_id}}",
      "quantity": 1
    }
  },
  "extract": {
    "orderId": "$.data.orderId"
  }
}
